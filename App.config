<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
    </startup>
    <!-- ContactPhone is deployment configuration. Keep this copy empty.
         Optional overrides belong in gitignored contact.local.config.
         A missing override file is ignored by the appSettings file attribute. -->
    <appSettings file="contact.local.config">
        <add key="ContactPhone" value="" />
    </appSettings>
</configuration>